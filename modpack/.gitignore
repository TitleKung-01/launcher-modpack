## Keep the repo light: release binary packs via GitHub Releases.
## Track only docs in git.

# Mods are large binaries
mods/**
!mods/.gitkeep

# Shaderpacks / Resourcepacks can be huge
shaderpacks/**
!shaderpacks/.gitkeep

resourcepacks/**
!resourcepacks/.gitkeep

# Config can contain personal / machine-specific settings.
config/**
!config/.gitkeep

# Common noise
**/*.bak
**/*.log
